# Copy this file to .env.local and fill in the two values from your Supabase
# dashboard: Project Settings -> API
#
# The anon key is safe to expose to the browser: every table in the schema has
# Row Level Security, so the key alone grants access to nothing.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
